# Copy to .env and fill in. NEVER commit .env
DATABASE_URL=sqlite:///./callbell.db
AWS_REGION=us-east-1
LLM_PROVIDER=bedrock   # set to "mock" to develop without AWS (dev only)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# AWS credentials: use `aws configure` or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_VOICE_ID=
ENABLE_TTS=false
FRONTEND_ORIGIN=http://localhost:5173
