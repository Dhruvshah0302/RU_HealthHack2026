# Leave BEDROCK_MODEL_ID empty to run in offline mode (keyword baseline, no AWS needed).
# To use the model, paste the model or inference-profile ID from the Bedrock console
# of your workshop account, and sign in to AWS in the same terminal.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# A model answer below this confidence goes to the nurse for review.
MIN_CONFIDENCE=0.7

# Voice (ElevenLabs). Leave ELEVENLABS_API_KEY empty to run without voice:
# the app still starts, and /api/transcribe and /api/speak return 503 so the
# browser falls back to the Web Speech API. The key is read on the server only
# and never reaches the browser. Do not commit a real key.
ELEVENLABS_API_KEY=
# One default voice for all languages for now (per-language voices come later).
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
