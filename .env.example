# Copy this file to .env and fill it in. Never commit .env.

# Speech to text for the patient page (ElevenLabs Scribe). Get a key at
# elevenlabs.io > Profile > API keys. Without it the page uses the browser's own recognition.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# The routing model on Amazon Bedrock. Understands any language. Leave BEDROCK_MODEL_ID empty to
# fall back to the English-only keyword matcher. Claude Haiku 4.5 is the model the team evaluated.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1

# AWS sign-in for Bedrock. From your workshop account's access portal ("Access keys"), or leave
# these out if you signed in with `aws configure` / `aws sso login`. Temporary keys expire.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
