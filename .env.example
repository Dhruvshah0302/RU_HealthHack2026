# Copy this file to .env and fill it in. Never commit .env.

# The model. Leave BEDROCK_MODEL_ID empty to run offline with the keyword sorter (no AWS needed).
# Otherwise use a Bedrock model or inference-profile ID, for example us.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# AWS access: either sign in to AWS in the terminal you start the app from,
# or paste a Bedrock API key here. These keys expire, so make a fresh one before a demo.
# AWS_BEARER_TOKEN_BEDROCK=

# A model answer below this confidence goes to the nurse for review.
MIN_CONFIDENCE=0.7

# Voice (optional). Without a key the bedside page uses the browser's own speech recognition.
ELEVENLABS_API_KEY=
# The voice for spoken replies. Leave empty to use the built-in default voice.
ELEVENLABS_VOICE_ID=
